{
    "name": "quillstack/header-bag",
    "description": "A simple solution to use headers according to PSR-7.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "headers",
        "http",
        "header-bag",
        "php",
        "psr-7",
        "php7"
    ],
    "homepage": "https://quillstack.org/packages/header-bag",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\HeaderBag\\": "src/",
            "Quillstack\\HeaderBag\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
